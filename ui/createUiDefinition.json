{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": true,
      "basics": {
        "description": "**azure-alert**：把 Azure 平台事件（Service Health、Project Flash、Resource Health、Metric、Quota、AKS 等）统一推送到飞书。",
        "location": {
          "label": "中心资源组区域",
          "visible": true
        }
      }
    },
    "basics": [
      {
        "name": "redeployInfo",
        "type": "Microsoft.Common.InfoBox",
        "visible": true,
        "options": {
          "style": "Warning",
          "text": "已经部署过、这次是添加模块或升级？请使用和第一次相同的订阅、资源组名称和前缀，勾选所有需要的模块（已部署的不会重复创建），并重新填写飞书 webhook 和按分类路由（这两项不会被记住）。资源组名称或前缀不同会再部署出一整套。点击查看说明。",
          "uri": "https://github.com/linkinchow/azure-alert#添加升级或删除模块"
        }
      },
      {
        "name": "resourceGroupName",
        "type": "Microsoft.Common.TextBox",
        "label": "中心资源组名称",
        "defaultValue": "rg-azure-alert",
        "constraints": {
          "required": true,
          "regex": "^[-\\w\\._\\(\\)]{1,90}$",
          "validationMessage": "1-90 个字母、数字、-、_、.、()"
        },
        "toolTip": "告警系统自身的资源（托管身份、Router、各模块 Logic App、Action Group）都建在这个资源组里，不存在会自动创建。"
      },
      {
        "name": "prefix",
        "type": "Microsoft.Common.TextBox",
        "label": "资源名前缀",
        "defaultValue": "aa",
        "constraints": {
          "required": true,
          "regex": "^[a-z][a-z0-9-]{1,9}$",
          "validationMessage": "2-10 个小写字母、数字或 -，以字母开头"
        },
        "toolTip": "所有资源名的前缀，例如 aa-router、aa-m1-service-health。同一订阅里部署多套时用不同前缀区分。"
      }
    ],
    "steps": [
      {
        "name": "modules",
        "label": "告警模块",
        "elements": [
          {
            "name": "modules",
            "type": "Microsoft.Common.DropDown",
            "label": "要部署的告警模块",
            "toolTip": "默认全选。M3 / M4 / M7 会在\"范围与权限\"一步选择的订阅里建告警规则；其余模块通过 Azure Resource Graph 轮询。",
            "multiselect": true,
            "selectAll": true,
            "multiLine": true,
            "defaultValue": [
              {
                "value": "serviceHealth"
              },
              {
                "value": "flash"
              },
              {
                "value": "resourceHealth"
              },
              {
                "value": "metric"
              },
              {
                "value": "quota"
              },
              {
                "value": "scheduledEvents"
              },
              {
                "value": "activityFailure"
              },
              {
                "value": "aks"
              }
            ],
            "constraints": {
              "allowedValues": [
                {
                  "label": "M1 服务健康",
                  "description": "服务问题、计划内维护、健康公告、安全公告、账单通知。每分钟查询一次 Azure Resource Graph。",
                  "value": "serviceHealth"
                },
                {
                  "label": "M2 Project Flash（VM / VMSS 平台事件）",
                  "description": "主机故障、硬件降级、热迁移、计划内冻结 / 维护、虚拟机崩溃、存储断连、预配超时、Spot 抢占。VM 和 VMSS 各一个 Logic App。",
                  "value": "flash"
                },
                {
                  "label": "M3 资源健康（全资源类型）",
                  "description": "所有资源类型的平台发起的不可用 / 降级（活动日志 level 为 Critical）。在每个选中的订阅里建一条活动日志告警规则。",
                  "value": "resourceHealth"
                },
                {
                  "label": "M4 指标示例（CPU、数据盘带宽）",
                  "description": "多资源指标告警示例：VM CPU 使用率、数据盘带宽使用率，阈值在\"范围与权限\"一步设置。每个区域一条规则。",
                  "value": "metric"
                },
                {
                  "label": "M5 计算配额",
                  "description": "计算配额使用率达到 80% / 90% / 95% 时提醒。",
                  "value": "quota"
                },
                {
                  "label": "M6 计划事件（需先决条件）",
                  "description": "VM / VMSS 维护的事前通知（重启、重新部署、冻结、抢占、终止）。订阅和 VM 需要先满足先决条件，见 modules/m6-scheduled-events/README.md。",
                  "value": "scheduledEvents"
                },
                {
                  "label": "M7 资源操作失败",
                  "description": "所有资源、所有操作中 level 为 Error / Critical 的失败（容量不足、配额不足、策略拒绝等会自动归类）。自动化调用多的环境量可能很大。",
                  "value": "activityFailure"
                },
                {
                  "label": "M8 AKS 升级与版本到期",
                  "description": "AKS 自动升级的计划和失败、Kubernetes 版本即将到期 / 已超出支持期。",
                  "value": "aks"
                },
                {
                  "label": "M9 Key Vault 到期提醒",
                  "description": "证书、机密、密钥到期前 30 天和过期时提醒。为下一步选中的现有 Key Vault 建 Event Grid 订阅，部署人需要对这些 Key Vault 所在资源组有 Event Grid 写权限；以后新建的 Key Vault 按文档接入。",
                  "value": "keyVaultExpiry"
                }
              ],
              "required": true
            },
            "visible": true
          }
        ]
      },
      {
        "name": "notify",
        "label": "飞书通知",
        "elements": [
          {
            "name": "defaultWebhook",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "默认飞书 webhook",
              "confirmPassword": "再次输入默认飞书 webhook（不显示）"
            },
            "constraints": {
              "required": true,
              "regex": "^https://open\\.(feishu\\.cn|larksuite\\.com)/open-apis/bot/v2/hook/.+$",
              "validationMessage": "请输入飞书 / Lark 自定义机器人 webhook"
            },
            "options": {
              "hideConfirmation": true
            },
            "toolTip": "飞书群自定义机器人的 webhook 地址。没有在\"按分类路由\"里单独指定的告警都发到这里。"
          },
          {
            "name": "routingInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "style": "Info",
              "text": "想把不同告警发到不同的飞书群，就在下面对应的分类后面填上该群的 webhook，不填的发到上面的默认 webhook。ServiceHealth = M1 服务健康，Flash = M2 VM 平台事件，ResourceHealth = M3 资源健康，Metric = M4 指标，Quota = M5 配额，ScheduledEvent = M6 计划事件，ActivityFailure = M7 操作失败，AKS = M8 AKS，KeyVault = M9 Key Vault 到期提醒，SelfMonitor = 告警系统自检。点击查看完整说明和示例。",
              "uri": "https://github.com/linkinchow/azure-alert#多个飞书群按分类路由"
            }
          },
          {
            "name": "webhookOverrides",
            "type": "Microsoft.Common.TextBox",
            "label": "按分类路由（可选）",
            "toolTip": "留空的分类发到默认 webhook。要把某个小类单独发到一个群，可以再加一行，例如 \"Flash.HostFailure\": \"https://...\"；完整分类名优先于模块前缀。[完整说明和示例](https://github.com/linkinchow/azure-alert#多个飞书群按分类路由)",
            "defaultValue": "{\n  \"ServiceHealth\": \"\",\n  \"Flash\": \"\",\n  \"ResourceHealth\": \"\",\n  \"Metric\": \"\",\n  \"Quota\": \"\",\n  \"ScheduledEvent\": \"\",\n  \"ActivityFailure\": \"\",\n  \"AKS\": \"\",\n  \"KeyVault\": \"\",\n  \"SelfMonitor\": \"\"\n}",
            "multiLine": true,
            "constraints": {
              "required": true,
              "regex": "^\\s*\\{[\\s\\S]*\\}\\s*$",
              "validationMessage": "请输入 JSON 对象：键用英文双引号，最后一项后面不要加逗号"
            }
          }
        ]
      },
      {
        "name": "scope",
        "label": "范围与权限",
        "elements": [
          {
            "name": "subscriptionsApi",
            "type": "Microsoft.Solutions.ArmApiControl",
            "request": {
              "method": "GET",
              "path": "subscriptions?api-version=2022-12-01"
            }
          },
          {
            "name": "readerScope",
            "type": "Microsoft.Common.DropDown",
            "label": "ARG 读取权限（Reader）授予方式",
            "defaultValue": "按订阅授予",
            "constraints": {
              "allowedValues": [
                {
                  "label": "按订阅授予",
                  "value": "subscription"
                },
                {
                  "label": "不授予（部署后用 scripts/grant-reader-mg.sh 在管理组上授予）",
                  "value": "none"
                }
              ]
            },
            "toolTip": "Pull 模块（M1 / M2 / M5 / M6 / M8）需要对被监控的订阅有 Reader 权限。按订阅授予会在每个选中的订阅上授予；也可以部署后在管理组上统一授予。"
          },
          {
            "name": "readerSubscriptionIds",
            "type": "Microsoft.Common.DropDown",
            "label": "要告警的订阅（Pull 模块读取范围，授予 Reader）",
            "multiselect": true,
            "selectAll": true,
            "filter": true,
            "visible": "[equals(steps('scope').readerScope, 'subscription')]",
            "constraints": {
              "allowedValues": "[map(steps('scope').subscriptionsApi.value, (item) => parse(concat('{\"label\":\"', item.displayName, ' (', item.subscriptionId, ')\",\"value\":\"', item.subscriptionId, '\"}')))]",
              "required": true
            },
            "toolTip": "这些订阅会给告警托管身份授予 Reader，Pull 模块只读取这些订阅。"
          },
          {
            "name": "excludedSubscriptionIds",
            "type": "Microsoft.Common.DropDown",
            "label": "排除的订阅（可选）",
            "multiselect": true,
            "selectAll": true,
            "filter": true,
            "visible": "[equals(steps('scope').readerScope, 'none')]",
            "constraints": {
              "allowedValues": "[map(steps('scope').subscriptionsApi.value, (item) => parse(concat('{\"label\":\"', item.displayName, ' (', item.subscriptionId, ')\",\"value\":\"', item.subscriptionId, '\"}')))]",
              "required": false
            },
            "toolTip": "在管理组上授权时，管理组下不想告警的订阅。"
          },
          {
            "name": "pushSubscriptionIds",
            "type": "Microsoft.Common.DropDown",
            "label": "部署 M3 / M4 / M7 告警规则的订阅",
            "multiselect": true,
            "selectAll": true,
            "filter": true,
            "visible": "true",
            "constraints": {
              "allowedValues": "[map(steps('scope').subscriptionsApi.value, (item) => parse(concat('{\"label\":\"', item.displayName, ' (', item.subscriptionId, ')\",\"value\":\"', item.subscriptionId, '\"}')))]",
              "required": true
            },
            "toolTip": "M3 / M4 / M7 的告警规则会建在这些订阅里，监控整个订阅。"
          },
          {
            "name": "metricRegions",
            "type": "Microsoft.Common.TextBox",
            "label": "M4 metric 规则的区域（逗号分隔，例如 eastus2,westus3）",
            "defaultValue": "[location()]",
            "constraints": {
              "required": true,
              "regex": "^\\s*[A-Za-z0-9]+(\\s*,\\s*[A-Za-z0-9]+)*\\s*$",
              "validationMessage": "区域名用逗号分隔，例如 eastus2,westus3"
            },
            "toolTip": "M4 指标规则按区域创建，多个区域用逗号分隔，例如 eastus2,westus3。"
          },
          {
            "name": "cpuThreshold",
            "type": "Microsoft.Common.TextBox",
            "label": "M4 CPU 告警阈值（%，5 分钟平均）",
            "defaultValue": "80",
            "toolTip": "平台 CPU 指标在部分规格上到不了 100%（实测 D2s_v5 最高 83.3%），建议 80。",
            "constraints": {
              "required": true,
              "regex": "^([1-9][0-9]?|100)$",
              "validationMessage": "1-100 的整数"
            }
          },
          {
            "name": "dataDiskBandwidthThreshold",
            "type": "Microsoft.Common.TextBox",
            "label": "M4 数据盘带宽使用率告警阈值（%，5 分钟平均）",
            "defaultValue": "100",
            "constraints": {
              "required": true,
              "regex": "^([1-9][0-9]?|100)$",
              "validationMessage": "1-100 的整数"
            }
          },
          {
            "name": "bootstrapSilent",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "首次运行静默（不推送历史事件）",
            "defaultValue": "是",
            "toolTip": "建议勾选：首次运行只记录当前已有的事件，不把历史事件一次性推进群。",
            "constraints": {
              "allowedValues": [
                {
                  "label": "是",
                  "value": "yes"
                },
                {
                  "label": "否",
                  "value": "no"
                }
              ],
              "required": true
            }
          },
          {
            "name": "sinkEnabled",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "事件落地到 Log Analytics 自定义表 AzureAlertEvents_CL",
            "defaultValue": "否",
            "toolTip": "把标准事件同时写入 Log Analytics 自定义表 AzureAlertEvents_CL，便于以后统计和分析。会新建一个工作区。",
            "constraints": {
              "allowedValues": [
                {
                  "label": "是",
                  "value": "yes"
                },
                {
                  "label": "否",
                  "value": "no"
                }
              ],
              "required": true
            }
          }
        ]
      },
      {
        "name": "keyvault",
        "label": "Key Vault（M9）",
        "visible": "[contains(steps('modules').modules, 'keyVaultExpiry')]",
        "elements": [
          {
            "name": "kvInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "style": "Info",
              "text": "选择要接入到期提醒的现有 Key Vault。部署时会在每个选中的 Key Vault 上建一个事件订阅（<前缀>-kv-expiry），Event Grid 会在 Key Vault 所在资源组自动创建或复用它的系统主题，不改动 Key Vault 本身。部署人需要对这些资源组有 Event Grid 写权限（EventGrid Contributor 或 Contributor），没有权限的请不要勾选。以后新建的 Key Vault 用脚本或门户接入，点击查看说明。",
              "uri": "https://github.com/linkinchow/azure-alert/blob/main/docs/keyvault-expiry.md"
            }
          },
          {
            "name": "kvApi",
            "type": "Microsoft.Solutions.ArmApiControl",
            "request": {
              "method": "POST",
              "path": "providers/Microsoft.ResourceGraph/resources?api-version=2021-03-01",
              "body": {
                "subscriptions": "[if(equals(steps('scope').readerScope, 'subscription'), steps('scope').readerSubscriptionIds, map(steps('scope').subscriptionsApi.value, (i) => i.subscriptionId))]",
                "query": "resources | where type =~ 'microsoft.keyvault/vaults' | project id, name, resourceGroup, subscriptionId | order by name asc",
                "options": {
                  "$top": 1000
                }
              }
            }
          },
          {
            "name": "keyVaultIds",
            "type": "Microsoft.Common.DropDown",
            "label": "要接入的 Key Vault",
            "multiselect": true,
            "selectAll": true,
            "filter": true,
            "multiLine": true,
            "toolTip": "列出\"范围与权限\"中所选订阅里的 Key Vault（最多 1000 个）。可以点\"全选\"。",
            "constraints": {
              "allowedValues": "[map(steps('keyvault').kvApi.data, (i) => parse(concat('{\"label\":\"', i.name, '\",\"description\":\"', i.resourceGroup, ' / ', i.subscriptionId, '\",\"value\":\"', i.id, '\"}')))]",
              "required": false
            },
            "visible": true
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "resourceGroupName": "[basics('resourceGroupName')]",
      "prefix": "[basics('prefix')]",
      "modules": {
        "serviceHealth": "[contains(steps('modules').modules, 'serviceHealth')]",
        "flash": "[contains(steps('modules').modules, 'flash')]",
        "resourceHealth": "[contains(steps('modules').modules, 'resourceHealth')]",
        "metric": "[contains(steps('modules').modules, 'metric')]",
        "quota": "[contains(steps('modules').modules, 'quota')]",
        "scheduledEvents": "[contains(steps('modules').modules, 'scheduledEvents')]",
        "activityFailure": "[contains(steps('modules').modules, 'activityFailure')]",
        "aks": "[contains(steps('modules').modules, 'aks')]",
        "keyVaultExpiry": "[contains(steps('modules').modules, 'keyVaultExpiry')]"
      },
      "defaultWebhook": "[steps('notify').defaultWebhook]",
      "webhooks": "[parse(steps('notify').webhookOverrides)]",
      "readerScope": "[steps('scope').readerScope]",
      "readerSubscriptionIds": "[if(equals(steps('scope').readerScope, 'subscription'), steps('scope').readerSubscriptionIds, parse('[]'))]",
      "pushSubscriptionIds": "[steps('scope').pushSubscriptionIds]",
      "metricRegions": "[split(toLower(replace(steps('scope').metricRegions, ' ', '')), ',')]",
      "bootstrapSilent": "[equals(steps('scope').bootstrapSilent, 'yes')]",
      "sinkEnabled": "[equals(steps('scope').sinkEnabled, 'yes')]",
      "argScope": "[if(equals(steps('scope').readerScope, 'subscription'), parse(concat('{\"subscriptions\":', string(steps('scope').readerSubscriptionIds), '}')), parse('{}'))]",
      "excludedSubscriptionIds": "[if(equals(steps('scope').readerScope, 'none'), coalesce(steps('scope').excludedSubscriptionIds, parse('[]')), parse('[]'))]",
      "cpuThreshold": "[int(steps('scope').cpuThreshold)]",
      "dataDiskBandwidthThreshold": "[int(steps('scope').dataDiskBandwidthThreshold)]",
      "keyVaultIds": "[if(contains(steps('modules').modules, 'keyVaultExpiry'), coalesce(steps('keyvault').keyVaultIds, parse('[]')), parse('[]'))]"
    }
  }
}
